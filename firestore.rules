rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every read and write the app makes goes through its server (Admin SDK), which checks
    // the user's role and record first. The browser SDK only loads the signed-in user's own
    // profile, so that is the one thing it may read; everything else is closed.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
