# ─────────────────────────────────────────────────────────────────────────────
# Firebase Client SDK (inlined into the browser bundle at build time)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"

# ─────────────────────────────────────────────────────────────────────────────
# Firebase Admin SDK (server only — never exposed to the browser)
# ─────────────────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID="your-project"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"

# Supply the private key EITHER as a raw PEM (escape newlines as \n) ...
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# ... OR base64-encoded (takes precedence when set; avoids newline-escaping issues
# on hosts that mangle multi-line env values). Leave blank if using FIREBASE_PRIVATE_KEY.
FIREBASE_PRIVATE_KEY_BASE64=""

# Storage bucket used by the product-image upload route (server-side Admin SDK).
# Usually the same value as NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET.
FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"

# ─────────────────────────────────────────────────────────────────────────────
# Optional: scheduled financial-health automation (POST /api/automation/financial-health)
# When set, a caller presenting this value in the `x-automation-secret` header is
# treated as a SYSTEM actor. Leave unset to require a normal ADMIN session instead.
# ─────────────────────────────────────────────────────────────────────────────
FINANCIAL_AUTOMATION_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# Demo mode — only for the public portfolio deployment. See .env.demo.example.
# Leave all three unset for a normal Firebase-backed deployment.
# ─────────────────────────────────────────────────────────────────────────────
# DEMO_MODE="true"
# NEXT_PUBLIC_DEMO_MODE="true"
# DEMO_SESSION_SECRET="change-me-to-a-random-string"
